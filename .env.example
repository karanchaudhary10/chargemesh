# Server
PORT=4000
# PostgreSQL connection string (required)
DATABASE_URL=postgres://chargemesh:chargemesh@localhost:5432/chargemesh
# Separate database used by `npm test` (wiped on every test run; name must end in _test)
TEST_DATABASE_URL=postgres://chargemesh:chargemesh@localhost:5432/chargemesh_test
STALE_AFTER_MS=60000
MAX_POWER_W=5000
ENERGY_JUMP_TOLERANCE=10
# Optional. Use a random value of at least 32 characters for CRE endpoints.
CRE_REPORT_TOKEN=

# Hedera (HCS) - server only
HEDERA_ENABLED=false
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

