{
  "name": "chargemesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @chargemesh/server run dev",
    "dev:web": "npm --workspace @chargemesh/web run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "npm --workspace @chargemesh/server run build",
    "build:web": "npm --workspace @chargemesh/web run build",
    "start": "npm --workspace @chargemesh/server run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:shared && npm run typecheck:server && npm run typecheck:web",
    "typecheck:shared": "tsc -p packages/shared/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p apps/server/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "hedera:create-topic": "tsx scripts/create-hcs-topic.ts",
    "hedera:verify-audit": "tsx scripts/verify-hcs-audit.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
