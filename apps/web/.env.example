# API base URL (leave empty to use same-origin; in dev Vite proxies /api to backend)
VITE_API_URL=

# Magic publishable key for the Hedera testnet wallet integration
VITE_MAGIC_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Public WalletConnect project ID used by HashConnect for HashPack pairing
VITE_HASHCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
